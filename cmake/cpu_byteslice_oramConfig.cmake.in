# Package configuration installed with the library: `find_package(
# cpu_byteslice_oram)` loads this file, which pulls in the Threads dependency
# (the rebuild owners and worker pools are std::threads) and imports the
# header-only target cpu_byteslice_oram::cpu_byteslice_oram.
@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Threads)

include("${CMAKE_CURRENT_LIST_DIR}/cpu_byteslice_oramTargets.cmake")
