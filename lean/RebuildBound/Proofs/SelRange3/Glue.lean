import RebuildBound.Spec.Selected
import RebuildBound.Proofs.P10r
import RebuildBound.Proofs.NCA5.Class
import RebuildBound.Proofs.SelRange1.Glue

/-!
# SelRange3: one class law and one shape at a terminal radix (package SelRange3)

The generic part of SelRange3; the tables, the kernel checks and the per-shape
theorems are generated by `gen.py`. Everything here holds for every odd radix
`r`, depth `t`, early cap `P`, `g = 2^i` roots and class mass `qc / 2^nb`.

* **The partial sums** (`ConvChain`, `chain_sound`): a list of NCA5 `checkConv`
  steps `S_{n+1} ≥ (S_n ∗ T)|_{≤ K}` bounds `truncPairConvPow K ν (n + steps)`.
* **One class** (`class_bound`, NCA5's `class_bound` generalized): NCA5's
  `thin_one` on a depth-`t` table of NCA1; the chain of partial sums; NCA5's
  `class_core` (root-loss marginal, NCA1's `final_sound` on the one-row table
  with its own truncation term switched off, P10r at `H = 256`). P10r's term is
  at most `g / 10^46` (NCA5's `eps_bound` at `c = 4000`) whenever
  `μ = 32 r q ≤ 33` and `r (2^t - 1) < 4000`.
* **The classes** (`sum_classes`): by NCA5's `qCount_eq`, every class mass is
  `(2^nb / r + 1) / 2^nb` or `(2^nb / r) / 2^nb`, so the class sum is at most
  `r` times a common bound of the two laws.
* **One shape** (`selRange_le`): the above with SelRange1's density bound
  `D ≤ 2^m / (2^m - n (num - 2^m))` and one integer inequality.
-/

open MeasureTheory ProbabilityTheory RebuildBound.Spec RebuildBound.Model
open scoped ENNReal NNReal unitInterval

namespace RebuildBound.SelRange3

open RebuildBound.NCA1 RebuildBound.NCA5

/-! ## The partial sums of the radix node -/

/-- The partial-sum checks: each step `(w, S')` checks `S' ≥ (S ∗ T)|_{≤ K}`. -/
def ConvChain (D K : ℕ) (T : List (List ℕ)) : List (List ℕ) → List (ℕ × List (List ℕ)) → Prop
  | _, [] => True
  | S, (w, S') :: rest => checkConv w D K S T S' = true ∧ ConvChain D K T S' rest

/-- The last table of a chain of partial sums. -/
def chainLast : List (List ℕ) → List (ℕ × List (List ℕ)) → List (List ℕ)
  | S, [] => S
  | _, (_, S') :: rest => chainLast S' rest

/-- **The partial sums**: a chain of `checkConv` steps from a bound of the `n`-th
partial sum bounds the `(n + steps)`-th. -/
theorem chain_sound {D K : ℕ} (hD : 0 < D) {T : List (List ℕ)} {ν : Measure (ℕ × ℕ)}
    (hν : Bounded D T ν) : ∀ (steps : List (ℕ × List (List ℕ))) (S : List (List ℕ)) (n : ℕ),
    ConvChain D K T S steps → Bounded D S (truncPairConvPow K ν n) →
    Bounded D (chainLast S steps) (truncPairConvPow K ν (n + steps.length))
  | [], S, n, _, hS => by simpa [chainLast] using hS
  | (w, S') :: rest, S, n, h, hS => by
    obtain ⟨hc, hrest⟩ := h
    have h1 : Bounded D S' (truncPairConvPow K ν (n + 1)) := conv_sound hD hc hS hν
    have h2 := chain_sound hD hν rest S' (n + 1) hrest h1
    rw [List.length_cons, ← Nat.add_assoc, Nat.add_right_comm n rest.length 1]
    simpa [chainLast, Nat.add_right_comm] using h2

/-! ## One class -/

/-- **One class** of the radix range law at `λ = 32`, `C = L = 64`, `H = 256`:
the thinning of a depth-`t` tree table by `q = qc / 2^nb`, the chain of partial
sums and the final check give `stopLoss ≤ tn / td + 2^i / 10^46`. The thinning
is checked at any representation `qcT / 2^nbT` of `q` (`hqT`; the generator uses
lowest terms, so classes with equal mass share one chain of tables and checks). -/
theorem class_bound (h10r : P10r_statement) {r t P i nb qc qcT nbT dp wT rr fuel tn td : ℕ}
    {F T : List (List ℕ)} {steps : List (ℕ × List (List ℕ))} (q : I)
    (hq : (q : ℝ) = (qc : ℝ) / ((2 ^ nb : ℕ) : ℝ))
    (hF : Bounded (2 ^ 320) F (truncTree 64 32 256 t))
    (hr : steps.length + 1 = r) (hrt : r * (2 ^ t - 1) + 1 ≤ 4000)
    (hqc : r * 32 * qc ≤ 33 * 2 ^ nb) (htd : 0 < td) (hdp : 2 ^ (nb + t) = dp)
    (hqT : qc * 2 ^ nbT = qcT * 2 ^ nb)
    (hT : checkThin wT qcT (2 ^ nbT) 64 256 F T = true)
    (hS : ConvChain (2 ^ 320) 256 T T steps)
    (hFin : checkFinal 648 (2 ^ 320) 100 rr 32 256 64 (2 ^ i) P qc dp 32 1 0 fuel tn td 0
      [rootMarg 64 (chainLast T steps)] = true) :
    stopLoss (rangeLawR 64 32 P (2 ^ i) t r q) 64 ≤
      (tn : ℝ≥0∞) / (td : ℕ) + (2 ^ i : ℝ≥0∞) / 10 ^ 46 := by
  have hD : 0 < 2 ^ 320 := by positivity
  have hqT' : (q : ℝ) = (qcT : ℝ) / ((2 ^ nbT : ℕ) : ℝ) := by
    rw [hq, div_eq_div_iff (by positivity) (by positivity)]
    exact_mod_cast hqT
  obtain ⟨hν, hS1⟩ := thin_one q (by positivity) hqT' hF hT
  have hSr := chain_sound hD hν steps T 1 hS hS1
  rw [show 1 + steps.length = r by omega] at hSr
  subst hdp
  refine (class_core h10r (c := 4000) (e := 46) q hq hqc hrt (by unfold TailOK; decide +kernel)
    htd hSr hFin).trans_eq ?_
  norm_num

/-! ## The classes -/

/-- **The classes**: every class mass is `(2^nb / r + 1) / 2^nb` or `(2^nb / r) / 2^nb`
(NCA5's `qCount_eq`), so a common bound of the two laws bounds the class sum. -/
lemma sum_classes {r W b nb qcA qcB : ℕ} {f : I → ℝ≥0∞} {B : ℝ≥0∞} (hnb : W - b = nb)
    (hA' : 2 ^ nb / r + 1 = qcA) (hB' : 2 ^ nb / r = qcB)
    (hA : ∀ q : I, (q : ℝ) = (qcA : ℝ) / ((2 ^ nb : ℕ) : ℝ) → f q ≤ B)
    (hB : ∀ q : I, (q : ℝ) = (qcB : ℝ) / ((2 ^ nb : ℕ) : ℝ) → f q ≤ B) :
    ∑ a ∈ Finset.range r, f (qMass W b r a) ≤ r * B := by
  calc ∑ a ∈ Finset.range r, f (qMass W b r a) ≤ ∑ _a ∈ Finset.range r, B := by
        refine Finset.sum_le_sum fun a ha => ?_
        have har := Finset.mem_range.mp ha
        have hc := qCount_eq (W := W) (b := b) har
        have hq := qMass_coe W b r a
        rw [hnb] at hc hq
        split_ifs at hc
        · exact hA _ (by rw [hq, hc, hA'])
        · exact hB _ (by rw [hq, hc, add_zero, hB'])
    _ = r * B := by rw [Finset.sum_const, Finset.card_range, nsmul_eq_mul]

/-! ## One shape -/

lemma add_div_pow {tn td i : ℕ} (htd : 0 < td) :
    (tn : ℝ≥0∞) / (td : ℕ) + (2 ^ i : ℝ≥0∞) / 10 ^ 46 =
      ((tn * 10 ^ 46 + 2 ^ i * td : ℕ) : ℝ≥0∞) / ((td * 10 ^ 46 : ℕ) : ℝ≥0∞) := by
  have h1 : ((td : ℕ) : ℝ≥0∞) ≠ 0 := by exact_mod_cast htd.ne'
  have h2 : (10 ^ 46 : ℝ≥0∞) ≠ 0 := by positivity
  have h2' : (10 ^ 46 : ℝ≥0∞) ≠ ⊤ := ENNReal.pow_ne_top (by simp)
  have e1 : (tn : ℝ≥0∞) / (td : ℕ) = (tn * 10 ^ 46 : ℝ≥0∞) / ((td : ℕ) * 10 ^ 46) :=
    (ENNReal.mul_div_mul_right _ _ h2 h2').symm
  have e2 : (2 ^ i : ℝ≥0∞) / 10 ^ 46 = (2 ^ i * (td : ℕ) : ℝ≥0∞) / ((td : ℕ) * 10 ^ 46) := by
    rw [mul_comm ((td : ℕ) : ℝ≥0∞)]
    exact (ENNReal.mul_div_mul_right _ _ h1 (ENNReal.natCast_ne_top _)).symm
  rw [e1, e2, ENNReal.div_add_div_same]
  congr 1 <;> push_cast <;> ring

/-- **One radix-`r` shape.** The shape's numbers are checked by `rfl` and the
arithmetic by `norm_num`. -/
theorem selRange_le (g : SepGeom) {r t i P nb qcA qcB n m num tn td bn bd : ℕ} {q : ℚ}
    (hr : g.r = r) (hC : g.C = 64) (ht : g.k - g.I = t) (hi : g.I = i) (hP : g.earlyCap = P)
    (hnb : 64 - g.k = nb) (hqA : 2 ^ nb / r + 1 = qcA) (hqB : 2 ^ nb / r = qcB)
    (hn : 32 * ((g.d - 1) * g.U) = n) (hm : SelRange1.oldExp g 64 = m)
    (hnum : SelRange1.oldNum g 64 = num)
    (hA : ∀ q : I, (q : ℝ) = (qcA : ℝ) / ((2 ^ nb : ℕ) : ℝ) →
      stopLoss (rangeLawR 64 32 P (2 ^ i) t r q) 64 ≤
        (tn : ℝ≥0∞) / (td : ℕ) + (2 ^ i : ℝ≥0∞) / 10 ^ 46)
    (hB : ∀ q : I, (q : ℝ) = (qcB : ℝ) / ((2 ^ nb : ℕ) : ℝ) →
      stopLoss (rangeLawR 64 32 P (2 ^ i) t r q) 64 ≤
        (tn : ℝ≥0∞) / (td : ℕ) + (2 ^ i : ℝ≥0∞) / 10 ^ 46)
    (hq : (q : ℝ) = (bn : ℝ) / (bd : ℕ))
    (hle : 2 ^ m ≤ num) (hlt : n * (num - 2 ^ m) < 2 ^ m) (htd : 0 < td) (hbd : 0 < bd)
    (hfin : 2 ^ m * 2 ^ t * (r * (tn * 10 ^ 46 + 2 ^ i * td)) * bd ≤
      bn * ((2 ^ m - n * (num - 2 ^ m)) * (td * 10 ^ 46))) :
    selRange g ≤ ENNReal.ofReal (q : ℝ) := by
  unfold selRange sepRange
  rw [hr, hC, ht, hi, hP, hn, SelRange1.oldDensity_eq, hm, hnum, hq]
  have hsum := sum_classes (W := 64) (b := g.k) (r := r) hnb hqA hqB hA hB
  have hsum' : ∑ a ∈ Finset.range r,
      stopLoss (rangeLawR 64 32 P (2 ^ i) t r (qMass 64 g.k r a)) 64 ≤
        ((r * (tn * 10 ^ 46 + 2 ^ i * td) : ℕ) : ℝ≥0∞) / ((td * 10 ^ 46 : ℕ) : ℝ≥0∞) := by
    rw [Nat.cast_mul, mul_div_assoc, ← add_div_pow htd]; exact hsum
  calc _ ≤ ((2 ^ m : ℕ) : ℝ≥0∞) / ((2 ^ m - n * (num - 2 ^ m) : ℕ) : ℝ≥0∞) * 2 ^ t *
        (((r * (tn * 10 ^ 46 + 2 ^ i * td) : ℕ) : ℝ≥0∞) / ((td * 10 ^ 46 : ℕ) : ℝ≥0∞)) := by
        gcongr
        exact SelRange1.density_le hle hlt
    _ ≤ _ := SelRange1.combine (by omega) (by positivity) hbd hfin

end RebuildBound.SelRange3
