import RebuildBound.Spec.Selected
import RebuildBound.Proofs.P10
import RebuildBound.Proofs.ShadowLaw.Tree
import RebuildBound.Proofs.NCA1

/-!
# SelRange1: the range term at `r = 1` (package SelRange1)

The generic part of SelRange1; the per-shape modules (`T<t>P<P>I<I>.lean`) are
generated by `gen.py`.

* **The law at `r = 1`.** `qMass W b 1 0 = 1`; `Bin(n, 1) = δ_n`, so thinning by
  `1` is the identity; `pairConvPow μ 1 = μ`; the root state's main count is at
  most `C` almost surely (every node is capped), so `radixRoot C λ t 1 1` is the
  law of `R_t`. Hence `rangeLawR C λ P g t 1 1 = rangeLaw C λ P 2^-t g t`
  (`rangeLawR_one`) and `sepRange` at `r = 1` is `D 2^(k-I)` times that
  stop-loss.
* **The stop-loss** (`range_le`): P10 at `H = 256` and NCA1's `final_sound`,
  from NCA1's root tables `Tab.t<t>` (`bnd6` … `bnd9`, from NCA1's level
  theorems).
* **The density** (`density_le`): `(num / 2^m)^n ≤ 2^m / (2^m - n (num - 2^m))`
  when `n (num - 2^m) < 2^m`, from `(1 + x)^n ≤ exp(n x) ≤ 1 / (1 - n x)`.
* **One shape** (`selRange_le`): all of the above, with the shape's numbers
  checked by `rfl` and `norm_num`.
-/

open MeasureTheory ProbabilityTheory RebuildBound.Spec RebuildBound.Model
open scoped ENNReal NNReal unitInterval

namespace RebuildBound.SelRange1

/-! ## The law at `r = 1` -/

lemma qMass_one (W b : ℕ) : qMass W b 1 0 = 1 := by
  have hq : qCount W b 1 0 = 2 ^ (W - b) := by
    rw [qCount, Finset.filter_true_of_mem (fun x _ => Nat.mod_one x), Finset.card_range]
  apply Subtype.ext
  simp only [qMass, hq, Set.Icc.coe_one]
  push_cast
  exact div_self (by positivity)

lemma binomial_one_right (n : ℕ) : binomial n (1 : I) = Measure.dirac n := by
  refine Measure.ext_of_singleton fun k => ?_
  rw [binomial_singleton, Measure.dirac_apply' _ (measurableSet_singleton k)]
  rcases lt_trichotomy k n with h | rfl | h
  · have : n - k ≠ 0 := by omega
    simp [this, Set.indicator, h.ne']
  · simp
  · simp [Nat.choose_eq_zero_of_lt h, Set.indicator, h.ne]

lemma thinPair_one : thinPair (1 : I) = Measure.dirac := by
  funext s
  rw [thinPair, binomial_one_right, binomial_one_right, Measure.dirac_prod_dirac]

lemma pairConvPow_one (μ : Measure (ℕ × ℕ)) [SFinite μ] : pairConvPow μ 1 = μ := by
  rw [pairConvPow, pairConvPow]
  exact Measure.dirac_zero_conv μ

lemma shadowTree_main_le (C : ℕ) (lam : ℝ≥0) :
    ∀ t, ∀ᵐ s ∂(shadowTree C lam t), s.1 ≤ C
  | 0 => by
    rw [shadowTree, ae_dirac_iff MeasurableSet.of_discrete]
    exact Nat.zero_le C
  | 1 => by
    rw [shadowTree, ae_map_iff Measurable.of_discrete.aemeasurable MeasurableSet.of_discrete]
    exact Filter.Eventually.of_forall fun n => min_le_right n C
  | t + 2 => by
    rw [shadowTree, ae_map_iff Measurable.of_discrete.aemeasurable MeasurableSet.of_discrete]
    exact Filter.Eventually.of_forall fun s => min_le_right s.1 C

lemma radixRoot_one (C : ℕ) (lam : ℝ≥0) (t : ℕ) :
    radixRoot C lam t 1 1 = (shadowTree C lam t).map Prod.snd := by
  have := P11eProof.isProb_shadowTree C lam t
  rw [radixRoot, thinPair_one, Measure.bind_dirac, pairConvPow_one]
  refine Measure.map_congr ?_
  filter_upwards [shadowTree_main_le C lam t] with s hs
  simp [Nat.sub_eq_zero_of_le hs]

lemma rangeLawR_one (C : ℕ) (lam : ℝ≥0) (P g t : ℕ) :
    rangeLawR C lam P g t 1 1 = rangeLaw C lam P (halfPow t) g t := by
  rw [rangeLawR, radixRoot_one, one_mul, rangeLaw]

/-! ## The stop-loss, from P10 and NCA1's tables -/

lemma bnd_step {w : ℕ} {t : ℕ} {F F' : List (List ℕ)}
    (hc : NCA1.checkLevel w 1 2 (2 ^ 320) 64 256 F F' = true)
    (h : NCA1.Bounded (2 ^ 320) F (truncTree 64 32 256 (t + 1))) :
    NCA1.Bounded (2 ^ 320) F' (truncTree 64 32 256 (t + 2)) :=
  NCA1.truncTree_step hc (by positivity) h

lemma bnd1 : NCA1.Bounded (2 ^ 320) NCA1.Tab.t1 (truncTree 64 32 256 1) := by
  have hlam : ((32 : ℝ≥0) : ℝ) = ((32 : ℕ) : ℝ) / ((1 : ℕ) : ℝ) := by norm_num
  rw [truncTree]
  exact NCA1.base_sound hlam (by positivity) NCA1.base

lemma bnd2 : NCA1.Bounded (2 ^ 320) NCA1.Tab.t2 (truncTree 64 32 256 2) := bnd_step NCA1.level2 bnd1
lemma bnd3 : NCA1.Bounded (2 ^ 320) NCA1.Tab.t3 (truncTree 64 32 256 3) := bnd_step NCA1.level3 bnd2
lemma bnd4 : NCA1.Bounded (2 ^ 320) NCA1.Tab.t4 (truncTree 64 32 256 4) := bnd_step NCA1.level4 bnd3
lemma bnd5 : NCA1.Bounded (2 ^ 320) NCA1.Tab.t5 (truncTree 64 32 256 5) := bnd_step NCA1.level5 bnd4
lemma bnd6 : NCA1.Bounded (2 ^ 320) NCA1.Tab.t6 (truncTree 64 32 256 6) := bnd_step NCA1.level6 bnd5
lemma bnd7 : NCA1.Bounded (2 ^ 320) NCA1.Tab.t7 (truncTree 64 32 256 7) := bnd_step NCA1.level7 bnd6
lemma bnd8 : NCA1.Bounded (2 ^ 320) NCA1.Tab.t8 (truncTree 64 32 256 8) := bnd_step NCA1.level8 bnd7
lemma bnd9 : NCA1.Bounded (2 ^ 320) NCA1.Tab.t9 (truncTree 64 32 256 9) := bnd_step NCA1.level9 bnd8

/-- The stop-loss of the range law at `λ = 32`, `C = L = 64`, `p = 2^-t`, `g = 2^i`,
from a final check against the depth-`t` table (P10 at `H = 256`, then NCA1's
`final_sound`). -/
theorem range_le {w rr fuel tn td s t P i : ℕ} {F : List (List ℕ)}
    (hc : NCA1.checkFinal w (2 ^ 320) 100 rr 32 256 64 (2 ^ i) P 1 (2 ^ t) 32 1 t fuel tn td s F =
      true)
    (hF : NCA1.Bounded (2 ^ 320) F (truncTree 64 32 256 t)) (htd : 0 < td) :
    stopLoss (rangeLaw 64 32 P (halfPow t) (2 ^ i) t) 64 ≤ (tn : ℝ≥0∞) / (td : ℕ) := by
  have hlam : ((32 : ℝ≥0) : ℝ) = ((32 : ℕ) : ℝ) / ((1 : ℕ) : ℝ) := by norm_num
  have hpe : ((halfPow t : I) : ℝ) = ((1 : ℕ) : ℝ) / ((2 ^ t : ℕ) : ℝ) := by
    simp [halfPow, one_div, inv_pow]
  refine (RebuildBound.P10 64 32 P (halfPow t) (2 ^ i) t 256 64 (by norm_num)).trans ?_
  exact NCA1.final_sound hc hF (NCA1.truncTree_univ_le 64 32 256 t) hlam hpe htd

/-! ## The density factor -/

lemma one_add_pow_le {x : ℝ} {n : ℕ} (hx : 0 ≤ x) (hnx : n * x < 1) :
    (1 + x) ^ n * (1 - n * x) ≤ 1 := by
  have h1 : (1 + x) ^ n ≤ Real.exp (n * x) := by
    rw [Real.exp_nat_mul]
    exact pow_le_pow_left₀ (by linarith) (by linarith [Real.add_one_le_exp x]) n
  have h2 : 1 - n * x ≤ Real.exp (-(n * x)) := by linarith [Real.add_one_le_exp (-(n * x))]
  calc (1 + x) ^ n * (1 - n * x) ≤ Real.exp (n * x) * Real.exp (-(n * x)) :=
        mul_le_mul h1 h2 (by linarith) (Real.exp_pos _).le
    _ = 1 := by rw [← Real.exp_add]; simp

/-- `(num / 2^m)^n ≤ 2^m / (2^m - n (num - 2^m))`. -/
lemma density_le {num m n : ℕ} (hle : 2 ^ m ≤ num) (hlt : n * (num - 2 ^ m) < 2 ^ m) :
    ((((num : ℝ≥0) / 2 ^ m) ^ n : ℝ≥0) : ℝ≥0∞) ≤
      ((2 ^ m : ℕ) : ℝ≥0∞) / ((2 ^ m - n * (num - 2 ^ m) : ℕ) : ℝ≥0∞) := by
  set δ := num - 2 ^ m with hδ
  have hnum : num = 2 ^ m + δ := by omega
  have hpos : 0 < 2 ^ m - n * δ := by omega
  have hden : ((2 ^ m - n * δ : ℕ) : ℝ) = 2 ^ m - n * δ := by
    rw [Nat.cast_sub hlt.le]; push_cast; ring
  have hreal : ((num : ℝ) / 2 ^ m) ^ n ≤ ((2 ^ m : ℕ) : ℝ) / ((2 ^ m - n * δ : ℕ) : ℝ) := by
    have h2m : (0 : ℝ) < 2 ^ m := by positivity
    have hx : (0 : ℝ) ≤ δ / 2 ^ m := by positivity
    have hnx : (n : ℝ) * (δ / 2 ^ m) < 1 := by
      rw [← mul_div_assoc, div_lt_one h2m]; exact_mod_cast hlt
    have key := one_add_pow_le hx hnx
    have he : (num : ℝ) / 2 ^ m = 1 + δ / 2 ^ m := by
      rw [hnum]; push_cast; field_simp
    have hd : (1 : ℝ) - n * (δ / 2 ^ m) = (2 ^ m - n * δ) / 2 ^ m := by field_simp
    have hpos' : (0 : ℝ) < 2 ^ m - n * δ := by rw [← hden]; exact_mod_cast hpos
    rw [he, hden, le_div_iff₀ hpos']
    rw [hd, mul_div_assoc', div_le_iff₀ h2m] at key
    push_cast
    linarith
  have hD0 : ((2 ^ m - n * δ : ℕ) : ℝ≥0) ≠ 0 := Nat.cast_ne_zero.2 hpos.ne'
  rw [← ENNReal.coe_natCast, ← ENNReal.coe_natCast, ← ENNReal.coe_div hD0, ENNReal.coe_le_coe,
    ← NNReal.coe_le_coe]
  simp only [NNReal.coe_pow, NNReal.coe_div, NNReal.coe_natCast, NNReal.coe_ofNat]
  exact hreal

/-! ## One shape -/

/-- The numerator of the old-map density (`SepGeom.oldDensity`). -/
def oldNum (g : SepGeom) (W : ℕ) : ℕ :=
  let D := g.d - 1
  let e := val2 D
  let r := D / 2 ^ e
  let k := g.K + e
  if k ≤ W then r * ((2 ^ (W - k) + r - 1) / r) else r * 2 ^ (k - W)

/-- The exponent of the denominator of the old-map density (0 below the
width). -/
def oldExp (g : SepGeom) (W : ℕ) : ℕ := W - (g.K + val2 (g.d - 1))

lemma oldDensity_eq (g : SepGeom) (W n : ℕ) :
    g.oldDensity W n = ((oldNum g W : ℝ≥0) / 2 ^ oldExp g W) ^ n := by
  unfold SepGeom.oldDensity oldNum oldExp
  dsimp only
  by_cases h : g.K + val2 (g.d - 1) ≤ W
  · rw [if_pos h, if_pos h]
  · have h0 : W - (g.K + val2 (g.d - 1)) = 0 := by omega
    rw [if_neg h, if_neg h, h0, pow_zero, div_one]

lemma combine {a b c d e f t : ℕ} (hb : 0 < b) (hd : 0 < d) (hf : 0 < f)
    (h : a * 2 ^ t * c * f ≤ e * (b * d)) :
    (a : ℝ≥0∞) / b * 2 ^ t * ((c : ℝ≥0∞) / d) ≤ ENNReal.ofReal ((e : ℝ) / f) := by
  have key : (a : ℝ) / b * 2 ^ t * ((c : ℝ) / d) ≤ (e : ℝ) / f := by
    rw [show (a : ℝ) / b * 2 ^ t * ((c : ℝ) / d) = (a * 2 ^ t * c : ℝ) / (b * d) by
      field_simp]
    rw [div_le_div_iff₀ (by positivity) (by positivity)]
    exact_mod_cast h
  calc (a : ℝ≥0∞) / b * 2 ^ t * ((c : ℝ≥0∞) / d)
      = ENNReal.ofReal ((a : ℝ) / b * 2 ^ t * ((c : ℝ) / d)) := by
        rw [ENNReal.ofReal_mul (by positivity), ENNReal.ofReal_mul (by positivity),
          ENNReal.ofReal_div_of_pos (by positivity), ENNReal.ofReal_div_of_pos (by positivity),
          ENNReal.ofReal_pow (by norm_num)]
        simp
    _ ≤ _ := ENNReal.ofReal_le_ofReal key

/-- **One `r = 1` shape.** The shape's numbers are checked by `rfl` (`n`, `m`, `num`,
the depth, the early cap) and `norm_num` (the arithmetic). -/
theorem selRange_le (g : SepGeom) {t i P n m num tn td bn bd : ℕ} {q : ℚ}
    (hr : g.r = 1) (hC : g.C = 64) (ht : g.k - g.I = t) (hi : g.I = i) (hP : g.earlyCap = P)
    (hn : 32 * ((g.d - 1) * g.U) = n) (hm : oldExp g 64 = m) (hnum : oldNum g 64 = num)
    (hX : stopLoss (rangeLaw 64 32 P (halfPow t) (2 ^ i) t) 64 ≤ (tn : ℝ≥0∞) / (td : ℕ))
    (hq : (q : ℝ) = (bn : ℝ) / (bd : ℕ))
    (hle : 2 ^ m ≤ num) (hlt : n * (num - 2 ^ m) < 2 ^ m) (htd : 0 < td) (hbd : 0 < bd)
    (hfin : 2 ^ m * 2 ^ t * tn * bd ≤ bn * ((2 ^ m - n * (num - 2 ^ m)) * td)) :
    selRange g ≤ ENNReal.ofReal (q : ℝ) := by
  unfold selRange sepRange
  rw [hr, Finset.sum_range_one, qMass_one, rangeLawR_one, hC, ht, hi, hP, hn, oldDensity_eq,
    hm, hnum, hq]
  calc _ ≤ ((2 ^ m : ℕ) : ℝ≥0∞) / ((2 ^ m - n * (num - 2 ^ m) : ℕ) : ℝ≥0∞) * 2 ^ t *
        ((tn : ℝ≥0∞) / (td : ℕ)) := by
        gcongr
        exact density_le hle hlt
    _ ≤ _ := combine (by omega) htd hbd hfin

end RebuildBound.SelRange1
