import RebuildBound.Spec.Selected
import RebuildBound.Proofs.P10r
import RebuildBound.Proofs.NCA5.Class
import RebuildBound.Proofs.SelRange1.Glue

/-!
# SelRange5: one class and one shape at `r = 5` (package SelRange5)

The generic part of SelRange5; the per-shape modules (`Shape<K>.lean`) and the
kernel checks are generated by `gen.py`.

* **One class** (`class_bound`): NCA5's `class_bound`, generalized over the
  tree depth `t ≤ 6`, the early cap `P`, the root count `g = 2^i` and the class
  mass `q = qc / 2^qe`. The tree law is bounded by a depth-`t` table of NCA1
  (`SelRange1.bnd<t>`, from NCA1's level theorems); NCA5's `checkThin` and
  `checkConv` (partial sums `2..5`) feed NCA5's `class_core` (root-loss marginal,
  NCA1's `checkFinal` with `p = qc / 2^(qe + t)`, P10r at `H = 256`). The class
  bound is `tn / td + g / 10^47`, the last term bounding P10r's truncation term.
* **The class sum** (`shape_sum`): `qCount 64 k 5 a = 2^(64-k)/5 + [a < 2^(64-k) mod 5]`
  (NCA5's `qCount_eq`), so two class laws bound the five classes.
* **One shape** (`selRange_le5`): at `d = 5` the old-map density is exactly 1
  (`d - 1 = 4` is a power of two), so `selRange g = 2^t Σ_a stopLoss(…)`;
  `budget_le` is the final arithmetic.
-/

open MeasureTheory ProbabilityTheory RebuildBound.Spec RebuildBound.Model
open scoped ENNReal NNReal unitInterval

namespace RebuildBound.SelRange5

open RebuildBound.NCA1 RebuildBound.NCA5

/-! ## One class -/

/-- **One class** of an `r = 5` range law at depth `t ≤ 6`, early cap `P`, `g = 2^i`
roots and class mass `q = qc / 2^qe`. -/
theorem class_bound {t i P qc qe dp wT w2 w3 w4 w5 rr fuel tn td : ℕ}
    {F T S2 S3 S4 S5 : List (List ℕ)} (q : I) (hq : (q : ℝ) = (qc : ℝ) / ((2 ^ qe : ℕ) : ℝ))
    (hqc : qc * 160 ≤ 33 * 2 ^ qe) (hdp : dp = 2 ^ (qe + t)) (ht : t ≤ 6) (htd : 0 < td)
    (hF : Bounded (2 ^ 320) F (truncTree 64 32 256 t))
    (hT : checkThin wT qc (2 ^ qe) 64 256 F T = true)
    (h2 : checkConv w2 (2 ^ 320) 256 T T S2 = true)
    (h3 : checkConv w3 (2 ^ 320) 256 S2 T S3 = true)
    (h4 : checkConv w4 (2 ^ 320) 256 S3 T S4 = true)
    (h5 : checkConv w5 (2 ^ 320) 256 S4 T S5 = true)
    (hFin : checkFinal 648 (2 ^ 320) 100 rr 32 256 64 (2 ^ i) P qc dp 32 1 0 fuel tn td 0
      [rootMarg 64 S5] = true) :
    stopLoss (rangeLawR 64 32 P (2 ^ i) t 5 q) 64 ≤
      (tn : ℝ≥0∞) / td + ((2 ^ i : ℕ) : ℝ≥0∞) / 10 ^ 47 := by
  have hD : 0 < 2 ^ 320 := by positivity
  subst hdp
  obtain ⟨hν, hS1⟩ := thin_one q (by positivity) hq hF hT
  exact class_core RebuildBound.P10r (r := 5) (c := 316) (e := 47) q hq (by omega)
    (by have := Nat.pow_le_pow_right (n := 2) (by norm_num) ht; omega)
    (by unfold TailOK; decide +kernel) htd (conv_sound hD h5 (conv_sound hD h4
      (conv_sound hD h3 (conv_sound hD h2 hS1 hν) hν) hν) hν) hFin

/-! ## The class sum -/

/-- **The five classes** from two class laws: `qCount 64 k 5 a` is `2^qe / 5 + 1` for
`a < 2^qe mod 5` and `2^qe / 5` otherwise (`qe = 64 - k`). -/
theorem shape_sum {k qe : ℕ} (hqe : 64 - k = qe) {f : I → ℝ≥0∞} {X : ℝ≥0∞}
    (hA : ∀ q : I, (q : ℝ) = ((2 ^ qe / 5 + 1 : ℕ) : ℝ) / ((2 ^ qe : ℕ) : ℝ) → f q ≤ X)
    (hB : ∀ q : I, (q : ℝ) = ((2 ^ qe / 5 : ℕ) : ℝ) / ((2 ^ qe : ℕ) : ℝ) → f q ≤ X) :
    ∑ a ∈ Finset.range 5, f (qMass 64 k 5 a) ≤ 5 * X := by
  have hcls : ∀ a ∈ Finset.range 5, f (qMass 64 k 5 a) ≤ X := by
    intro a ha
    have hc := qCount_eq (W := 64) (b := k) (Finset.mem_range.mp ha)
    have hm := qMass_coe 64 k 5 a
    rw [hqe] at hc hm
    by_cases h : a < 2 ^ qe % 5
    · simp only [h, ↓reduceIte] at hc
      exact hA _ (by rw [hm, hc])
    · simp only [h, ↓reduceIte, add_zero] at hc
      exact hB _ (by rw [hm, hc])
  refine (Finset.sum_le_sum hcls).trans ?_
  rw [Finset.sum_const, Finset.card_range, nsmul_eq_mul]
  norm_num

/-! ## One shape -/

/-- **One `r = 5` shape** with old-map density 1: `selRange g = 2^t Σ_a stopLoss(…)`. -/
theorem selRange_le5 (g : SepGeom) {t i P k : ℕ} {X : ℝ≥0∞} {q : ℚ}
    (hr : g.r = 5) (hC : g.C = 64) (ht : g.k - g.I = t) (hk : g.k = k) (hi : g.I = i)
    (hP : g.earlyCap = P) (hnum : SelRange1.oldNum g 64 = 2 ^ SelRange1.oldExp g 64)
    (hS : ∑ a ∈ Finset.range 5, stopLoss (rangeLawR 64 32 P (2 ^ i) t 5 (qMass 64 k 5 a)) 64 ≤ X)
    (hfin : 2 ^ t * X ≤ ENNReal.ofReal (q : ℝ)) :
    selRange g ≤ ENNReal.ofReal (q : ℝ) := by
  unfold selRange sepRange
  rw [SelRange1.oldDensity_eq, hnum, ht, hk, hi, hr, hC, hP]
  have h1 : ((((2 ^ SelRange1.oldExp g 64 : ℕ) : ℝ≥0) / 2 ^ SelRange1.oldExp g 64) ^
      (32 * ((g.d - 1) * g.U)) : ℝ≥0) = 1 := by
    rw [Nat.cast_pow, Nat.cast_ofNat, div_self (pow_ne_zero _ two_ne_zero), one_pow]
  rw [h1, ENNReal.coe_one, one_mul]
  exact (mul_le_mul_right hS _).trans hfin

/-- The final arithmetic: `2^t · 5 (tn / td + g / 10^47) ≤ bn / bd`. -/
lemma budget_le {t g tn td bn bd : ℕ} {q : ℚ} (hq : (q : ℝ) = (bn : ℝ) / (bd : ℕ))
    (htd : 0 < td) (hbd : 0 < bd)
    (h : 2 ^ t * 5 * (tn * 10 ^ 47 + g * td) * bd ≤ bn * (td * 10 ^ 47)) :
    (2 : ℝ≥0∞) ^ t * (5 * ((tn : ℝ≥0∞) / (td : ℝ≥0∞) + (g : ℝ≥0∞) / 10 ^ 47)) ≤
      ENNReal.ofReal (q : ℝ) := by
  have key : (2 : ℝ) ^ t * (5 * ((tn : ℝ) / td + (g : ℝ) / 10 ^ 47)) ≤ (q : ℝ) := by
    rw [hq, show (2 : ℝ) ^ t * (5 * ((tn : ℝ) / td + (g : ℝ) / 10 ^ 47)) =
      (2 ^ t * 5 * (tn * 10 ^ 47 + g * td) : ℝ) / (td * 10 ^ 47) by field_simp]
    rw [div_le_div_iff₀ (by positivity) (by positivity)]
    exact_mod_cast h
  calc (2 : ℝ≥0∞) ^ t * (5 * ((tn : ℝ≥0∞) / (td : ℝ≥0∞) + (g : ℝ≥0∞) / 10 ^ 47))
      = ENNReal.ofReal ((2 : ℝ) ^ t * (5 * ((tn : ℝ) / td + (g : ℝ) / 10 ^ 47))) := by
        rw [ENNReal.ofReal_mul (by positivity), ENNReal.ofReal_mul (by norm_num),
          ENNReal.ofReal_add (by positivity) (by positivity),
          ENNReal.ofReal_div_of_pos (by positivity), ENNReal.ofReal_div_of_pos (by positivity),
          ENNReal.ofReal_pow (by norm_num), ENNReal.ofReal_pow (by norm_num)]
        simp
    _ ≤ _ := ENNReal.ofReal_le_ofReal key

/-- The final arithmetic for a class sum `≤ a / 10^e`: `2^t a / 10^e ≤ bn / bd`. -/
lemma budget_le' {t a e bn bd : ℕ} {q : ℚ} (hq : (q : ℝ) = (bn : ℝ) / (bd : ℕ)) (hbd : 0 < bd)
    (h : 2 ^ t * a * bd ≤ bn * 10 ^ e) :
    (2 : ℝ≥0∞) ^ t * ((a : ℝ≥0∞) / 10 ^ e) ≤ ENNReal.ofReal (q : ℝ) := by
  have key : (2 : ℝ) ^ t * ((a : ℝ) / 10 ^ e) ≤ (q : ℝ) := by
    rw [hq, ← mul_div_assoc, div_le_div_iff₀ (by positivity) (by positivity)]
    exact_mod_cast h
  calc (2 : ℝ≥0∞) ^ t * ((a : ℝ≥0∞) / 10 ^ e)
      = ENNReal.ofReal ((2 : ℝ) ^ t * ((a : ℝ) / 10 ^ e)) := by
        rw [ENNReal.ofReal_mul (by positivity), ENNReal.ofReal_div_of_pos (by positivity),
          ENNReal.ofReal_pow (by norm_num), ENNReal.ofReal_pow (by norm_num)]
        simp
    _ ≤ _ := ENNReal.ofReal_le_ofReal key

end RebuildBound.SelRange5
