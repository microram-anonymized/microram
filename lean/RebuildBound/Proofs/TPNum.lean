import RebuildBound.Spec.TopPrepG
import RebuildBound.Proofs.P10r
import RebuildBound.Proofs.NTop
import RebuildBound.Proofs.NCA5.Class
import RebuildBound.Proofs.SelRange1.Glue
import RebuildBound.Proofs.TPNum.Thin
import RebuildBound.Proofs.TPNum.Final

/-!
# TPNum: the selected top preparation's bound is at most `2^-115` (package TPNum)

`tpBound selectedTP 32 1 256 256 ≤ 2^-115`: the 22 stage stashes and the drain
(`Φ_256(2^22, 64, 32, 128)`, NTop's checker `phiNum` at scale `2^400`, one
`decide +kernel`), and the range term `2^9 · stopLoss(rangeLawR 64 32 1792 2^14 8 1 half) 64`.

**The range term.** NCA1's depth-8 root table `Tab.t8` (`truncTree 64 32 256 8`,
scale `2^320`; NCA1's level theorems through `SelRange1.bnd8`, nothing is
rechecked) is thinned by `1/2` in both coordinates (`NCA5.checkThin`, the
thinning exact, one rounding up to scale `D`; table `TPNum.Tab.th`). At `r = 1` the
radix root is that thinned tree law's root-loss marginal `v + (u - C)₊`
(`NCA5.rootMarg`), whose main count is at most `C` anyway. NCA1's `checkFinal`
on `[rootMarg 64 TPNum.Tab.th]` at `P = 1792`, `p = 2^-9`, `g = 2^14` (`t = 0`,
`s = 0`) bounds the stop-loss of the zero-completed truncated law; P10r adds
`g √((μ + μ²) 255 τ_256(32)) ≤ 10^-42` (`μ = 16`). The certified stop-loss is
`2.0312 · 10^-38` (target `2.1 · 10^-38`), the range term `1.040 · 10^-35`
(Python `1.017 · 10^-35`).

**Φ.** `Φ ≤ 2^-125` (certified; Python `1.4 · 10^-38 = 2^-126.06`), so
`23 Φ ≤ 5.5 · 10^-37`; the total is at most `1.1 · 10^-35 ≤ 2^-115 = 2.35 · 10^-35`.

Tables and checks are generated by `TPNum/gen.py` (`python3 gen.py 21 39`).

**Kernel cost** (`decide +kernel`, one `lean` process per module, from the
profiler / `/usr/bin/time`):

| module  | kernel | wall   | peak RSS |
|---------|--------|--------|----------|
| `Thin`  | 6.9 s  | 8.8 s  | 2.7 GB   |
| `Final` | 2.9 s  | 5.0 s  | 1.6 GB   |

The Φ check (`TPNum_phi`, scale `2^400`) is a fraction of a second. Building the
package takes about 17 s wall at 4.3 GB peak RSS.
-/

open MeasureTheory ProbabilityTheory RebuildBound.Spec
open scoped ENNReal NNReal unitInterval

namespace RebuildBound

open NCA5 NCA1

/-- `half` as a thinning probability `1/2`. -/
lemma TPNum_range : stopLoss (rangeLawR 64 32 1792 (2 ^ 14) 8 1 half) 64 ≤
    ((21 : ℕ) : ℝ≥0∞) / ((10 ^ 39 : ℕ) : ℝ≥0∞) + 1 / 10 ^ 42 := by
  have hq : (half : ℝ) = ((1 : ℕ) : ℝ) / ((2 : ℕ) : ℝ) := by norm_num [half]
  obtain ⟨-, hS1⟩ := thin_one half (by norm_num) hq SelRange1.bnd8 TPNum.thin
  refine (class_core RebuildBound.P10r (r := 1) (t := 8) (M := 1) (c := 256) (e := 47) half
    (by norm_num [half]) (by norm_num) (by norm_num) (by unfold TailOK; decide +kernel)
    (by norm_num) hS1 TPNum.final).trans
    (add_le_add le_rfl ((div_pow_ten_le (b := 1) (f := 42) (by norm_num)).trans_eq ?_))
  norm_num

lemma TPNum_range_real : stopLoss (rangeLawR 64 32 1792 (2 ^ 14) 8 1 half) 64 ≤
    ENNReal.ofReal (21 / 10 ^ 39) + ENNReal.ofReal (1 / 10 ^ 42) := by
  have h1 : ((21 : ℕ) : ℝ≥0∞) / ((10 ^ 39 : ℕ) : ℝ≥0∞) = ENNReal.ofReal (21 / 10 ^ 39) := by
    rw [ENNReal.ofReal_div_of_pos (by positivity)]; norm_num
  have h2 : (1 : ℝ≥0∞) / 10 ^ 42 = ENNReal.ofReal (1 / 10 ^ 42) := by
    rw [ENNReal.ofReal_div_of_pos (by positivity)]; norm_num
  rw [← h1, ← h2]
  exact TPNum_range

lemma comb_ofReal {x y : ℝ} (hx : 0 ≤ x) (hy : 0 ≤ y) :
    (22 : ℝ≥0∞) * ENNReal.ofReal x + 2 ^ 9 * ENNReal.ofReal y + ENNReal.ofReal x =
      ENNReal.ofReal (22 * x + 2 ^ 9 * y + x) := by
  rw [ENNReal.ofReal_add (by positivity) hx, ENNReal.ofReal_add (by positivity) (by positivity),
    ENNReal.ofReal_mul (by norm_num), ENNReal.ofReal_mul (by norm_num), ENNReal.ofReal_pow (by norm_num)]
  norm_num

theorem TPNum_phi : NTop.phiNum (2 ^ 400) 100 32 256 (2 ^ 22) 64 128 32 1 * 2 ^ 125 ≤ 2 ^ 400 := by
  decide +kernel

set_option exponentiation.threshold 500 in
theorem TPNum : Spec.TPNum_statement := by
  unfold Spec.TPNum_statement Spec.tpBound Spec.tpRangeTerm
  have hk : Spec.selectedTP.k = 22 := rfl
  have hT : Spec.selectedTP.T = 2 ^ 22 := by decide +kernel
  have hC : Spec.selectedTP.C = 64 := rfl
  have hI : Spec.selectedTP.I = 13 := rfl
  have hb : Spec.selectedTP.rangeBits = 9 := rfl
  have hdfs : Spec.selectedTP.dfs = true := rfl
  have hcap : Spec.selectedTP.earlyCap = 1792 := by decide +kernel
  have hs : Spec.selectedTP.stashPages * Spec.selectedTP.C = 128 := by decide +kernel
  have hd : Spec.selectedTP.drainPages * Spec.selectedTP.C = 128 := by decide +kernel
  rw [hs, hd, hdfs, hT, hcap, hC, hk, hb, hI]
  have hphi : Phi 256 (2 ^ 22) 64 (((32 : ℝ≥0)) : ℝ) 128 ≤ 1 / 2 ^ 125 := by
    have hD : 0 < 2 ^ 400 := by positivity
    have h2 := NTop.phi_sound hD 100 32 256 (2 ^ 22) 64 128 32 1 one_pos (by norm_num)
      (by norm_num) (by norm_num) NTop_pos
    have e : (((32 : ℕ) : ℝ) / ((1 : ℕ) : ℝ)) = ((32 : ℝ≥0) : ℝ) := by norm_num
    rw [e] at h2
    refine h2.trans ?_
    rw [div_le_div_iff₀ (by positivity) (by positivity)]
    have := TPNum_phi
    exact_mod_cast (by simpa [mul_comm] using this : _)
  have hR := TPNum_range_real
  simp only [ite_true, Nat.cast_ofNat, NNReal.coe_one, one_mul, ENNReal.coe_one]
  rw [show rangeLawR 64 32 1792 (2 ^ (13 + 1)) (22 - 1 - 13) 1 half =
    rangeLawR 64 32 1792 (2 ^ 14) 8 1 half from rfl]
  have hx := ENNReal.ofReal_le_ofReal hphi
  calc _ ≤ 22 * ENNReal.ofReal (1 / 2 ^ 125) +
        2 ^ 9 * (ENNReal.ofReal (21 / 10 ^ 39) + ENNReal.ofReal (1 / 10 ^ 42)) +
        ENNReal.ofReal (1 / 2 ^ 125) := by gcongr
    _ = ENNReal.ofReal (22 * (1 / 2 ^ 125) + 2 ^ 9 * (21 / 10 ^ 39 + 1 / 10 ^ 42) + 1 / 2 ^ 125) := by
        rw [← ENNReal.ofReal_add (by positivity) (by positivity)]
        exact comb_ofReal (by positivity) (by positivity)
    _ ≤ _ := ENNReal.ofReal_le_ofReal (by norm_num)

end RebuildBound
