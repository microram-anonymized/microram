   const sn::oram::uid_generator& uid_gen() const noexcept { return uid_gen_; }
 
-  sn::crypto::buffered_prng<>& prng() noexcept { return prng_; }
+  // P-S1 (benchmark patch): one generator per thread. Concurrent accesses and the eviction team rebuild buckets on
+  // several threads at once, and a buffered_prng (a buffer plus an OpenSSL context) is not thread-safe. Each thread's
+  // generator seeds itself from random_device; callers must call prng() on the thread that uses the result.
+  sn::crypto::buffered_prng<>& prng() noexcept {
+    thread_local sn::crypto::buffered_prng<> per_thread;
+    return per_thread;
+  }
   const sn::crypto::buffered_prng<>& prng() const noexcept { return prng_; }
 
